{
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "title", "summary", "graphs", "memory_updates"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graph_id",
          "title",
          "graph_summary",
          "nodes",
          "topological_order",
          "final_node_ids",
          "confidence"
        ],
        "properties": {
          "graph_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "graph_summary": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "statement", "dependencies", "proof_hint"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "kind": {
                  "type": "string",
                  "enum": ["theorem_hypothesis", "definition", "standard_fact", "lemma", "conclusion"]
                },
                "statement": {
                  "type": "string"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                  }
                },
                "proof_hint": {
                  "type": "string"
                }
              }
            }
          },
          "topological_order": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "final_node_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "memory_updates": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fact_id", "fact_kind", "statement", "justification", "implication_id", "premise_fact_ids", "conclusion_fact_id", "reason"],
        "properties": {
          "type": {"type": "string", "enum": ["fact_upsert", "fact_delete", "implication_upsert", "implication_delete"]},
          "fact_id": {"type": ["string", "null"]},
          "fact_kind": {"type": ["string", "null"], "enum": ["hypothesis", "definition", "derived", "external", null]},
          "statement": {"type": ["string", "null"]},
          "justification": {"type": ["string", "null"]},
          "implication_id": {"type": ["string", "null"]},
          "premise_fact_ids": {"type": ["array", "null"], "items": {"type": "string"}},
          "conclusion_fact_id": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
