{
  "type": "object",
  "additionalProperties": false,
  "required": ["approved", "score", "strongest_task_id", "issues", "revision_tasks"],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strongest_task_id": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_tasks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "instructions", "expected_output"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          }
        }
      }
    }
  }
}

