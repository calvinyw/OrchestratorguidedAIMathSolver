{
  "type": "object",
  "additionalProperties": false,
  "required": ["approved", "score", "strongest_task_id", "issues", "revision_tasks", "memory_updates"],
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strongest_task_id": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_tasks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "instructions", "expected_output"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          }
        }
      }
    },
    "memory_updates": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fact_id", "fact_kind", "statement", "justification", "implication_id", "premise_fact_ids", "conclusion_fact_id", "reason"],
        "properties": {
          "type": {"type": "string", "enum": ["fact_upsert", "fact_delete", "implication_upsert", "implication_delete"]},
          "fact_id": {"type": ["string", "null"]},
          "fact_kind": {"type": ["string", "null"], "enum": ["hypothesis", "definition", "derived", "external", null]},
          "statement": {"type": ["string", "null"]},
          "justification": {"type": ["string", "null"]},
          "implication_id": {"type": ["string", "null"]},
          "premise_fact_ids": {"type": ["array", "null"], "items": {"type": "string"}},
          "conclusion_fact_id": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
