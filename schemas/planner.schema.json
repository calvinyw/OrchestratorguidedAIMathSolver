{
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "tasks", "success_criteria", "memory_updates"],
  "properties": {
    "analysis": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agent", "title", "instructions", "expected_output"],
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_updates": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "fact_id", "fact_kind", "statement", "justification", "implication_id", "premise_fact_ids", "conclusion_fact_id", "reason"],
        "properties": {
          "type": {"type": "string", "enum": ["fact_upsert", "fact_delete", "implication_upsert", "implication_delete"]},
          "fact_id": {"type": ["string", "null"]},
          "fact_kind": {"type": ["string", "null"], "enum": ["hypothesis", "definition", "derived", "external", null]},
          "statement": {"type": ["string", "null"]},
          "justification": {"type": ["string", "null"]},
          "implication_id": {"type": ["string", "null"]},
          "premise_fact_ids": {"type": ["array", "null"], "items": {"type": "string"}},
          "conclusion_fact_id": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
