{
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "title", "latex_document", "confidence", "notes"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "latex_document": {
      "type": "string",
      "description": "A complete, compilable LaTeX article containing the question first and then the solution."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
